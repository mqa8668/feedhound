# Copy to .env and fill in real values. Never commit .env.

# Postgres. Dev processes refuse a database whose name is not *_dev unless ALLOW_PROD_DB=1.
DATABASE_URL=postgres://feedhound:CHANGE_ME@127.0.0.1:5433/feedhound_dev

# Integration tests only; the database may be truncated freely. Test code
# refuses to run unless the database name ends with "_test".
TEST_DATABASE_URL=postgres://feedhound:CHANGE_ME@127.0.0.1:5433/feedhound_test

# Required by docker-compose's postgres service (no default).
POSTGRES_USER=feedhound
POSTGRES_PASSWORD=CHANGE_ME

# Telegram bot
TG_BOT_TOKEN=
# Optional Telegram API base override (tests/proxies); empty = the real api.telegram.org.
TG_API_BASE=

# Optional LLM enrichment (any OpenAI-compatible endpoint). Leave empty to run on rules only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o

# Logging
LOG_LEVEL=info

# Ports
API_PORT=4820
AGENT_PORT=4821
BOT_PORT=4822
WEB_PORT=4823

# Seed
SEED_OPERATOR_EMAIL=

# Authentication. AUTH_MODE=local (default): one operator, password login at /login.
# AUTH_MODE=cf-access: validate Cloudflare Access JWTs (see CF_ACCESS_* below).
AUTH_MODE=local
# bcrypt/argon2id hash. Generate: bun -e 'console.log(await Bun.password.hash("your-password"))'
# In production the api refuses to start in local mode without it.
AUTH_PASSWORD_HASH=
# Development only: plaintext password (ignored when NODE_ENV=production; a warning is logged).
AUTH_PASSWORD=
# HMAC key for the session cookie. If unset a random key is generated at boot and sessions reset on restart.
SESSION_SECRET=
# Force the Secure cookie flag (it is also set automatically for https / X-Forwarded-Proto: https).
AUTH_COOKIE_SECURE=
# Extra origins (comma separated) allowed for cookie-authenticated writes and /ws, e.g. a dev proxy.
AUTH_ALLOWED_ORIGINS=
# Loopback-only setups: allow local mode with no password at all (production boot guard).
AUTH_ALLOW_NO_PASSWORD=
# Local mode refuses to start when PUBLIC_URL / PUBLIC_HOSTNAME is a non-loopback host; set 1 to override.
AUTH_MODE_LOCAL_I_KNOW=
PUBLIC_URL=

# Cloudflare Access (optional, for exposing the dashboard).
# CF_ACCESS_AUD is the JWT audience the api validates on every route.
CF_ACCESS_AUD=
# Team domain, e.g. "myteam.cloudflareaccess.com". JWKS is fetched from https://<domain>/cdn-cgi/access/certs.
CF_ACCESS_TEAM_DOMAIN=

# "development" or "production" (compose defaults to "production" if unset).
NODE_ENV=development

# Local development only (never honoured when NODE_ENV=production): enables the `X-Dev-User` header bypass (the user must already exist).
# Ships empty on purpose. The api refuses to start with this set to 1 while CF_ACCESS_AUD is
# set and/or NODE_ENV=production.
DEV_AUTH_BYPASS=

# apps/web dev server only: sent as the X-Dev-User header.
VITE_DEV_USER=

# Public dashboard hostname, used by infra/smoke.sh --public. Not a secret.
PUBLIC_HOSTNAME=

# Image tag the compose services are pinned to (defaults to "latest").
IMAGE_TAG=latest

# ApiKey (scope "ops") used by infra/backup.sh to POST /api/ops/notify on failure.
OPS_API_KEY=

# Optional offsite backup copy (infra/backup.sh). Leave unset to skip the upload.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Thumbnail cache directory (agent writes, api reads). Docker uses the feedhound_media volume at /data/media.
MEDIA_DIR=./data/media

# --- Docker Compose quickstart -------------------------------------------------
# Compose needs only POSTGRES_PASSWORD (above). Everything below is optional.
# Host ports (all bound to 127.0.0.1). Change when a port is already taken.
PG_PUBLISH=5433
API_PUBLISH=4820
AGENT_PUBLISH=4821
BOT_PUBLISH=4822
WEB_PUBLISH=4823
# SEED_OPERATOR_EMAIL (above) empty = operator@feedhound.local under compose.
# `docker compose --profile demo up -d --build` adds fixture feeds and demo watches.
# DEMO_OFFLINE=1 leaves out the internet source (hnrss.org) so the demo needs no network.
DEMO_OFFLINE=
